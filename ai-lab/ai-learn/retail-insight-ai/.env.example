# =============================================================================
# 首次配置（只做一次）：
#   cp .env.example .env
#   编辑 .env 填入真实数据库连接（DATABASE_URL 或 POSTGRES_*）
#   .env 已被 .gitignore 忽略，禁止提交
#
# 日常本地启动（不要再 export）：
#   ./scripts/start_local.sh
# 日常本地停止：
#   ./scripts/stop_local.sh
# Docker 日常：
#   ./scripts/compose_up.sh
# =============================================================================
# 不要在此文件写入真实密钥或生产密码。

APP_NAME=Retail Insight AI
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=retail-insight-ai
LEARNING_TRACE=false
TASK_EXECUTION_MODE=background
RESEARCH_PROVIDER=static
DATA_PROVIDER=static

# ---- Repository / PostgreSQL ----
# 正式业务：postgres。InMemory 仅 unittest，不是页面正式运行模式。
REPOSITORY_BACKEND=postgres
#
# 【本地完整开发 · 方式一】WSL 宿主 PostgreSQL 库 erip_local（推荐 Unix socket + peer，无需密码）
# DATABASE_URL=postgresql+psycopg:///erip_local?host=/var/run/postgresql
# 首次建库：./scripts/setup_host_postgres_local.sh
# 禁止：erip_integration_test 当页面库；禁止依赖 erip-local-pg Docker 容器
#
# 【Docker Compose · 方式二】容器内库名默认 erip（见 compose）；与宿主 erip_local 隔离
# DATABASE_URL=postgresql+psycopg://erip_app:CHANGE_ME@127.0.0.1:5432/erip
#
# 方式 B：离散字段；start_local 可在未设置 DATABASE_URL 时组装（socket host 以 / 开头）
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DB=erip_local
POSTGRES_USER=CHANGE_ME_OS_USER
# 若使用 peer/socket，可省略密码。TCP 密码认证时再设置（只写 .env，勿提交）。
# POSTGRES_PASSWORD=

# Compose 对外端口（可选；日常不必 export）
BACKEND_PORT=8000
FRONTEND_PORT=8080
# JWT：本地默认仅用于 local/test；staging/production 必须覆盖
JWT_SECRET_KEY=erip-local-jwt-signing-key-change-before-deployment-2026
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:5173","http://localhost:5173"]
WORKFLOW_STEP_DELAY_SECONDS=0.05
STATIC_RESEARCH_FAIL=false

# ---- LLM Provider Mode ----
# 权威枚举：stub | openrouter | fallback_chain
# 日常本地 start_local 会强制 stub + 关闭全部 RUN_*_SMOKE
# stub：仅 stub-low-cost / stub-high-quality，无网络，默认开发与自动测试
# fallback_chain：OpenRouter → NVIDIA → Gemini → Local Qwen（严格串行）
# openrouter：单 Provider 兼容模式（仍经 Gateway / Ledger / Audit）
LLM_PROVIDER_MODE=stub
# 兼容旧变量名；与 LLM_PROVIDER_MODE 保持一致
LLM_PROVIDER=stub

# Fallback Chain 总超时与最大 attempt（每个 Provider 默认只尝试一次）
LLM_TOTAL_TIMEOUT_SECONDS=120
LLM_MAX_PROVIDER_ATTEMPTS=4
# Circuit Breaker（测试使用可控时钟，不 sleep）
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_DURATION_SECONDS=30
LLM_CIRCUIT_HALF_OPEN_PROBE_LIMIT=1

# ---- OpenRouter ----
# 价格单位：USD / 百万 tokens（input 与 output 分开配置；写入 Ledger 后成为历史 snapshot）
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LOW_COST_MODEL=
OPENROUTER_HIGH_QUALITY_MODEL=
OPENROUTER_LOW_INPUT_PRICE=0.500000
OPENROUTER_LOW_OUTPUT_PRICE=1.500000
OPENROUTER_HIGH_INPUT_PRICE=3.000000
OPENROUTER_HIGH_OUTPUT_PRICE=9.000000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Retail Insight AI
OPENROUTER_ATTEMPT_TIMEOUT_SECONDS=20
# 兼容旧单超时 / 单 Provider openrouter 模式
REAL_LLM_TIMEOUT_SECONDS=30
REAL_LLM_MAX_RETRIES=1

# ---- NVIDIA（OpenAI-compatible）----
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LOW_COST_MODEL=
NVIDIA_HIGH_QUALITY_MODEL=
# 价格单位：USD / 百万 tokens
NVIDIA_LOW_INPUT_PRICE=0.200000
NVIDIA_LOW_OUTPUT_PRICE=0.600000
NVIDIA_HIGH_INPUT_PRICE=1.000000
NVIDIA_HIGH_OUTPUT_PRICE=3.000000
NVIDIA_ATTEMPT_TIMEOUT_SECONDS=20

# ---- Gemini ----
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_LOW_COST_MODEL=
GEMINI_HIGH_QUALITY_MODEL=
# 价格单位：USD / 百万 tokens
GEMINI_LOW_INPUT_PRICE=0.100000
GEMINI_LOW_OUTPUT_PRICE=0.400000
GEMINI_HIGH_INPUT_PRICE=1.250000
GEMINI_HIGH_OUTPUT_PRICE=5.000000
GEMINI_ATTEMPT_TIMEOUT_SECONDS=20

# ---- Local Qwen（本地 OpenAI-compatible endpoint；不自动下载/安装/启动模型）----
LOCAL_QWEN_ENABLED=false
LOCAL_QWEN_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_QWEN_LOW_COST_MODEL=
LOCAL_QWEN_HIGH_QUALITY_MODEL=
# 可选；LOCAL_QWEN_REQUIRE_API_KEY=false 时可不设置 Key
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_REQUIRE_API_KEY=false
# Local 通常无云费用；价格单位仍为 USD / 百万 tokens（可为 0）
LOCAL_QWEN_LOW_INPUT_PRICE=0.000000
LOCAL_QWEN_LOW_OUTPUT_PRICE=0.000000
LOCAL_QWEN_HIGH_INPUT_PRICE=0.000000
LOCAL_QWEN_HIGH_OUTPUT_PRICE=0.000000
LOCAL_QWEN_ATTEMPT_TIMEOUT_SECONDS=60

# 仅手动 smoke；默认测试 suite 不得打开（可能产生费用 / 消耗本机资源）
RUN_REAL_LLM_SMOKE=0
RUN_OPENROUTER_SMOKE=0
RUN_NVIDIA_SMOKE=0
RUN_GEMINI_SMOKE=0
RUN_LOCAL_QWEN_SMOKE=0

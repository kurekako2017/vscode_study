# 复制为项目根目录 .env 后按部署环境调整。不要在此文件写入真实密钥。
APP_NAME=Retail Insight AI
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=retail-insight-ai
LEARNING_TRACE=false
TASK_EXECUTION_MODE=background
RESEARCH_PROVIDER=static
DATA_PROVIDER=static
REPOSITORY_BACKEND=inmemory
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=retail_insight_ai
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_password
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
WORKFLOW_STEP_DELAY_SECONDS=0.05
STATIC_RESEARCH_FAIL=false

# ---- LLM Provider Mode（默认 stub；自动测试必须保持 stub）----
# stub：无网络、零费用；openrouter：真实 OpenRouter 调用（仍经 Gateway/Quota/Ledger）
LLM_PROVIDER_MODE=stub
# 兼容旧变量名；与 LLM_PROVIDER_MODE 保持一致
LLM_PROVIDER=stub

# ---- OpenRouter（仅后端；切勿写入 Frontend 或 Git 真实值）----
# 留空表示未配置。生产/openrouter 模式缺少 Key 或模型时启动 fail-closed。
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 模型名称必须由运维配置，不写死在业务代码中
OPENROUTER_LOW_COST_MODEL=
OPENROUTER_HIGH_QUALITY_MODEL=
# 每百万 token 的 Decimal 价格快照（USD）；写入 Ledger 后不因后续配置变化改写历史
OPENROUTER_LOW_INPUT_PRICE=0.500000
OPENROUTER_LOW_OUTPUT_PRICE=1.500000
OPENROUTER_HIGH_INPUT_PRICE=3.000000
OPENROUTER_HIGH_OUTPUT_PRICE=9.000000
# 可选 OpenRouter 归因 Header
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Retail Insight AI
REAL_LLM_TIMEOUT_SECONDS=30
REAL_LLM_MAX_RETRIES=1
# 仅手动 smoke；默认测试 suite 不得打开
RUN_REAL_LLM_SMOKE=0
